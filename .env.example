# Copy this file to .env before running a live investigation.
# Do not commit .env or real API keys.

# Groq is the only supported LLM provider in this mini project.
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# Graph safety limits
AGENT_MAX_ITERATIONS=8
LANGGRAPH_RECURSION_LIMIT=20

# Local paths are relative to the mini-sar directory.
DATABASE_PATH=data/aml.db
DATASET_PATH=
EVIDENCE_LOG_DIR=audit/evidence_logs
SAR_DRAFT_DIR=audit/sar_drafts
